{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/generate-tasks",
      "schedule": "0 8 * * 0"
    }
  ],
  "routes": [
    {
      "src": "/(sq|en|de)/packages",
      "dest": "/$1/packages",
      "headers": { "x-strehe-surface": "marketing" }
    }
  ]
}